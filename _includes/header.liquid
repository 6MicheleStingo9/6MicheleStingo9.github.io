<header>
  <!-- Nav Bar -->
  <nav id="navbar" class="navbar navbar-light navbar-expand-sm {% if site.navbar_fixed %}fixed-top{% else %}sticky-top{% endif %}" role="navigation">
    <div class="container">
      {% comment %} Home of the language being read, not of the site. {% endcomment %}
      {% assign home_permalink = '/' %}
      {% if page.lang == 'it' %}
        {% assign home_permalink = '/it/' %}
      {% endif %}
      {% if page.permalink != home_permalink %}
        <a class="navbar-brand title font-weight-lighter" href="{{ home_permalink | relative_url }}">
          {% if site.title == 'blank' %}
            {% if site.first_name %}
              <span class="font-weight-bold">
                {{- site.first_name -}}
              </span>
            {% endif %}
            {% if site.middle_name %}
              {{- site.middle_name -}}
            {% endif %}
            {% if site.last_name %}
              {{- site.last_name -}}
            {% endif %}
          {% else %}
            {{- site.title -}}
          {% endif %}
        </a>
      {% elsif site.enable_navbar_social %}
        <!-- Social Icons -->
        <div class="navbar-brand social">{% social_links %}</div>
      {% endif %}
      <!-- Navbar Toggle -->
      <button
        class="navbar-toggler collapsed ml-auto"
        type="button"
        data-toggle="collapse"
        data-target="#navbarNav"
        aria-controls="navbarNav"
        aria-expanded="false"
        aria-label="{{ site.data.lang[page.lang].nav.toggle }}"
      >
        <span class="sr-only">{{ site.data.lang[page.lang].nav.toggle }}</span>
        <span class="icon-bar top-bar"></span>
        <span class="icon-bar middle-bar"></span>
        <span class="icon-bar bottom-bar"></span>
      </button>

      <div class="collapse navbar-collapse text-right" id="navbarNav">
        <ul class="navbar-nav ml-auto flex-nowrap">
          {% comment %}
            The home entry, taken from whichever page owns this language's root
            permalink. The loop variable is p: naming it page would shadow the
            page being rendered.
          {% endcomment %}
          {% for p in site.pages %}
            {% if p.permalink == home_permalink %}
              {% assign about_title = p.title %}
            {% endif %}
          {% endfor %}

          <!-- About -->
          <li class="nav-item {% if page.permalink == home_permalink %}active{% endif %}">
            <a class="nav-link" href="{{ home_permalink | relative_url }}">
              {{- about_title }}
              {% if page.permalink == '/' %}
                <span class="sr-only">(current)</span>
              {% endif %}
            </a>
          </li>

          <!-- Other pages -->
          {% assign sorted_pages = site.pages | sort: 'nav_order' %}
          {% for p in sorted_pages %}
            {% if p.nav and p.autogen == null and p.lang == page.lang %}
              {% if p.dropdown %}
                {% assign has_active_child = false %}
                {% for child in p.children %}
                  {% if page.title == child.title %}
                    {% assign has_active_child = true %}
                  {% endif %}
                {% endfor %}
                <li class="nav-item dropdown {% if page.title == p.title or has_active_child %}active{% endif %}">
                  <a
                    class="nav-link dropdown-toggle"
                    href="#"
                    id="navbarDropdown"
                    role="button"
                    data-toggle="dropdown"
                    aria-haspopup="true"
                    aria-expanded="false"
                  >
                    {{- p.title }}
                    {% if page.title == p.title or has_active_child %}
                      <span class="sr-only">(current)</span>
                    {% endif %}
                  </a>
                  <div class="dropdown-menu dropdown-menu-right" aria-labelledby="navbarDropdown">
                    {% for child in p.children %}
                      {% if child.title == 'divider' %}
                        <div class="dropdown-divider"></div>
                      {% else %}
                        <a
                          class="dropdown-item {% if page.title == child.title %}active{% endif %}"
                          href="{% if child.permalink contains '://' %}{{ child.permalink }}{% else %}{{ child.permalink | relative_url }}{% endif %}"
                        >
                          {{- child.title -}}
                        </a>
                      {% endif %}
                    {% endfor %}
                  </div>
                </li>
              {% else %}
                {% assign parent_link = p.permalink | remove: 'index.html' %}
                <li class="nav-item {% if page.url contains parent_link %}active{% endif %}">
                  {%- if p.permalink contains '://' -%}
                    {%- assign url = p.permalink -%}
                  {%- elsif p.permalink contains '/blog/' -%}
                    {%- comment -%}
                      al-folio wrote the literal '/blog/' here because
                      jekyll-paginate-v2 replaces this page and p.url is then
                      not the address a reader should be given. The permalink
                      is -- and unlike a literal it is right in both languages.
                      '/it/blog/' contains '/blog/' too, so the literal was
                      sending every Italian page to the English blog.
                    {%- endcomment -%}
                    {%- assign url = p.permalink | remove: 'index.html' -%}
                  {%- else -%}
                    {%- assign url = p.url -%}
                  {%- endif %}
                  <a class="nav-link" href="{{ url | relative_url }}">
                    {{- p.title }}
                    {% if page.url contains p.url %}
                      <span class="sr-only">(current)</span>
                    {% endif %}
                  </a>
                </li>
              {% endif %}
            {% endif %}
          {% endfor %}
          {% if site.search_enabled %}
            <!-- Search -->
            <li class="nav-item">
              <button id="search-toggle" title="{{ site.data.lang[page.lang].nav.search }}" onclick="openSearchModal()">
                <span class="nav-link">ctrl k <i class="fa-solid fa-magnifying-glass"></i></span>
              </button>
            </li>
          {% endif %}
          {% if site.enable_darkmode %}
            <!-- Toogle theme mode -->
            <li class="toggle-container">
              <button id="light-toggle" title="{{ site.data.lang[page.lang].nav.theme }}">
                <i class="fa-half-sun-moon" id="light-toggle-system"></i>
                <i class="fa-solid fa-moon" id="light-toggle-dark"></i>
                <i class="fa-solid fa-sun" id="light-toggle-light"></i>
              </button>
            </li>
          {% endif %}

          {% comment %}
            Language switch. Not a toggle like the theme button: the twin of
            this page is a different document at a different URL, so this is a
            link. Mirrored paths, so the twin's address is this one with /it
            added or removed. Inert when the twin does not exist yet.
          {% endcomment %}
          {% comment %}
            Paginated pages report a URL ending in index.html, so both sides of
            the comparison are normalised before matching.
          {% endcomment %}
          {% include twin.liquid %}
          <li class="toggle-container">
            {% if twin_exists %}
              <a class="lang-toggle" href="{{ twin_url | relative_url }}" title="{{ site.data.lang[page.lang].nav.switch }}">
                {{- site.data.lang[page.lang].nav.other_code -}}
              </a>
            {% else %}
              <span class="lang-toggle disabled" title="{{ site.data.lang[page.lang].nav.unavailable }}">
                {{- site.data.lang[page.lang].nav.other_code -}}
              </span>
            {% endif %}
          </li>
        </ul>
      </div>
    </div>
  </nav>
  {% if site.enable_progressbar %}
    <!-- Scrolling Progress Bar -->
    <progress id="progress" value="0">
      <div class="progress-container">
        <span class="progress-bar"></span>
      </div>
    </progress>
  {% endif %}
</header>
